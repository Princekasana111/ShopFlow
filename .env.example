# Copy to .env and fill in what you need. Everything has a working default.

# --- LLM ---------------------------------------------------------------------
# auto (default): Claude if ANTHROPIC_API_KEY is set, else the local model if LOCAL_LLM_URL is set,
# else the free offline mode.
LLM_PROVIDER=auto
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5-5
# ANTHROPIC_FALLBACKS=1           # server-side refusal fallbacks (beta)
# AI_EFFORT_ASSISTANT=medium      # low | medium | high | xhigh | max
# AI_EFFORT_STRUCTURED=low
# AI_FALLBACK_TO_OFFLINE=1        # answer in offline mode when Claude can't be reached

# --- Free local model (optional) ----------------------------------------------
# A small open model (Qwen2.5 3B, Apache 2.0) served by Ollama in Docker, used between Claude and
# the offline rules. Uncomment both lines; the first start downloads about 2 GB. If it is stopped,
# missing or slow, the app quietly uses the offline rules instead.
# COMPOSE_PROFILES=local-llm
# LOCAL_LLM_URL=http://ollama:11434   # running Django outside Docker? use http://127.0.0.1:11434
# LOCAL_LLM_MODEL=qwen2.5:3b
# LOCAL_LLM_FEATURES=rag_answer,product_qa   # which calls it answers ("all" = every one)
# LOCAL_LLM_TIMEOUT_SECONDS=60

# --- Embeddings (local, free) --------------------------------------------------
# EMBEDDING_PROVIDER=fastembed    # fastembed (BAAI/bge-small-en-v1.5) | hash (tests)
# VISUAL_PROVIDER=clip            # photo search: clip | off

# --- Django ------------------------------------------------------------------
# DJANGO_SECRET_KEY=change-me
# DJANGO_DEBUG=1
# The Docker Compose database is created with postgres/postgres. If you change these,
# change them in docker-compose.yml too, or the backend can't connect.
# POSTGRES_DB=shopflow
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=postgres
# DB_HOST=localhost
# DB_PORT=5433

# --- Demo accounts created by `manage.py bootstrap` ----------------------------
# SEED_ADMIN_PASSWORD=admin12345
# SEED_DEMO_PASSWORD=demo12345

# --- Docker ------------------------------------------------------------------
# GUNICORN_WORKERS=2              # each worker loads the AI models (~0.9 GB); use 1 on small machines
